# Backend proxy settings for Dify Chat API
DIFY_API_URL=https://your-dify-host/v1/chat-messages
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional lightweight Dify chatbot used only to classify ambiguous meeting-room availability intent.
# DIFY_MEETING_INTENT_API_URL defaults to DIFY_API_URL when omitted.
DIFY_MEETING_INTENT_API_URL=https://your-dify-host/v1/chat-messages
DIFY_MEETING_INTENT_API_KEY=app-yyyyyyyyyyyyyyyyyyyyyyyy

# Authelia remote-user allowed to access the admin backend.
ADMIN_REMOTE_USER=admin

# Invoice backend (used by /invoice-proxy). Defaults to 127.0.0.1:8082 if unset.
INVOICE_HOST=127.0.0.1
INVOICE_PORT=8082

# Chency Meet backend used by /api/meeting-availability.
CHENCY_MEET_API_URL=http://127.0.0.1:8081
CHENCY_MEET_AI_SECRET=replace-with-the-shared-secret
